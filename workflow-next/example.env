# 复制为 workflow-next/.env。留空使用默认值；同名 shell 环境变量优先。
# .env 不执行 shell、不展开 ${变量}。文件不会提交到 Git。

# 不填或 false：继承当前 Codex 环境的 provider、订阅登录或自定义 key。
layering_custom_provider=false
# true 时两项必填；地址应包含网关要求的 API 前缀（通常 /v1）。
layering_provider_base_url=
layering_provider_api_key=

# 最后一个后缀是思考力度，不是模型 ID 的一部分。
# 支持 none/minimal/low/medium/high/xhigh，具体取决于所选模型。
layering_medium_model=gpt-6.1-sol-xhigh
layering_high_model=gpt-6-astra-xhigh

# 可选：独立生图服务，仍由 Codex 原生 image_gen.imagegen 执行。
# 地址与 key 都留空时继承 Codex 自己的生图能力；只填模型名不会启用。
# 启用后需要下方的补丁版 Codex 路径，且不会替换主模型的 provider。
layering_image_base_url=
layering_image_api_key=
layering_image_model=gpt-image-2.5-sunburst

# 可选：同一 agent 当前上下文中的图片出现次数达到该数时原线程 compact。
# 留空关闭。如上游最多接受 50 张图，可填 49。
layering_image_compact_threshold=

# 生图服务或图片 compact 开启时使用补丁版：先运行 pnpm build:codex。
# 相对路径以 workflow-next 为基准；Windows 路径末尾为 codex.exe。
layering_codex_path=
# layering_codex_path=.codex-build/bin/codex

# 通常不填，保留当前 CODEX_HOME 或 ~/.codex，确保原 thread 历史仍可读取。
layering_codex_home=
