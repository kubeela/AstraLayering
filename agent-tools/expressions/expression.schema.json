{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Astra expression controls and commands - draft 0.1.0",
  "description": "Project contract draft: rig definitions and LLM commands. SVG references, parameter ranges and morph topology require semantic validation; schema validation alone does not prove animation quality.",
  "oneOf": [
    {
      "$ref": "#/$defs/rig"
    },
    {
      "$ref": "#/$defs/command"
    }
  ],
  "$defs": {
    "parameter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "number"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "default": {
              "type": "number"
            },
            "access": {
              "enum": [
                "public",
                "animation"
              ]
            },
            "role": {
              "enum": [
                "control",
                "phase"
              ]
            }
          },
          "required": [
            "type",
            "label",
            "description",
            "min",
            "max",
            "default",
            "access",
            "role"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "enum"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "default": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "access": {
              "enum": [
                "public",
                "animation"
              ]
            }
          },
          "required": [
            "type",
            "label",
            "description",
            "choices",
            "default",
            "access"
          ],
          "additionalProperties": false
        }
      ]
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "point"
            },
            "svg_id": {
              "type": "string",
              "minLength": 1
            },
            "point": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "type",
            "svg_id",
            "point"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "path_vertex"
            },
            "svg_id": {
              "type": "string",
              "minLength": 1
            },
            "command_index": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "svg_id",
            "command_index"
          ],
          "additionalProperties": false
        }
      ]
    },
    "attachment": {
      "type": "object",
      "properties": {
        "svg_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "follow": {
          "enum": [
            "position",
            "affine"
          ]
        },
        "sample": {
          "enum": [
            "continuous",
            "cycle_start"
          ]
        },
        "clock": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      },
      "required": [
        "svg_id",
        "anchor",
        "offset",
        "follow",
        "sample"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sample": {
                "const": "cycle_start"
              }
            }
          },
          "then": {
            "required": [
              "clock"
            ]
          },
          "else": {
            "not": {
              "required": [
                "clock"
              ]
            }
          }
        }
      ]
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "path_morph"
            },
            "svg_id": {
              "type": "string",
              "minLength": 1
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            },
            "interpolation": {
              "enum": [
                "linear",
                "bilinear"
              ]
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "at": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 1,
                    "maxItems": 2
                  },
                  "d": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "at",
                  "d"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            }
          },
          "required": [
            "type",
            "svg_id",
            "parameters",
            "interpolation",
            "keys"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "scalar_map"
            },
            "svg_id": {
              "type": "string",
              "minLength": 1
            },
            "parameter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "property": {
              "enum": [
                "opacity",
                "translate_x",
                "translate_y",
                "scale_x",
                "scale_y",
                "rotate"
              ]
            },
            "pivot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 2
            },
            "interpolation": {
              "enum": [
                "linear",
                "smoothstep",
                "step"
              ]
            }
          },
          "required": [
            "type",
            "svg_id",
            "parameter",
            "property",
            "pivot",
            "keys",
            "interpolation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "variant"
            },
            "parameter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "cases": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "minProperties": 1
            }
          },
          "required": [
            "type",
            "parameter",
            "cases"
          ],
          "additionalProperties": false
        }
      ]
    },
    "track": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "blend": {
          "enum": [
            "replace",
            "add",
            "multiply"
          ]
        },
        "interpolation": {
          "enum": [
            "linear",
            "smoothstep",
            "step"
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time_s": {
                "type": "number",
                "minimum": 0
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "time_s",
              "value"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        }
      },
      "required": [
        "parameter",
        "blend",
        "interpolation",
        "keys"
      ],
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loop": {
          "type": "boolean"
        },
        "seam": {
          "enum": [
            "continuous",
            "hidden_reset",
            "not_applicable"
          ]
        },
        "fade_in_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_s": {
          "type": "number",
          "minimum": 0
        },
        "exit": {
          "enum": [
            "fade",
            "finish_cycle"
          ]
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 1
        }
      },
      "required": [
        "label",
        "description",
        "duration_s",
        "loop",
        "seam",
        "fade_in_s",
        "fade_out_s",
        "exit",
        "tracks"
      ],
      "additionalProperties": false
    },
    "play": {
      "type": "object",
      "properties": {
        "animation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "animation",
        "speed",
        "weight"
      ],
      "additionalProperties": false
    },
    "expression": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "minProperties": 0
        },
        "animations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/play"
          },
          "minItems": 0
        },
        "fade_in_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "label",
        "description",
        "parameters",
        "animations",
        "fade_in_s",
        "fade_out_s"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "parameter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "op": {
          "enum": [
            "eq",
            "gte",
            "lte"
          ]
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "required": [
        "parameter",
        "op",
        "value"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        },
        "require": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "when",
        "require",
        "message"
      ],
      "additionalProperties": false
    },
    "rig": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "document_type": {
          "const": "rig"
        },
        "character_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "svg": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          },
          "minProperties": 1
        },
        "anchors": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/anchor"
          },
          "minProperties": 0
        },
        "attachments": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/attachment"
          },
          "minProperties": 0
        },
        "bindings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          },
          "minProperties": 1
        },
        "animations": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/animation"
          },
          "minProperties": 0
        },
        "expressions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/expression"
          },
          "minProperties": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "document_type",
        "character_id",
        "svg",
        "parameters",
        "anchors",
        "attachments",
        "bindings",
        "animations",
        "expressions",
        "constraints"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "document_type": {
          "const": "command"
        },
        "character_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "actions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_parameters"
                  },
                  "values": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_.-]*$"
                    },
                    "additionalProperties": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "minProperties": 1
                  },
                  "transition_s": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "op",
                  "values",
                  "transition_s"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "apply_expression"
                  },
                  "expression": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "op",
                  "expression",
                  "instance_id",
                  "weight"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "release_expression"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  }
                },
                "required": [
                  "op",
                  "instance_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "play_animation"
                  },
                  "animation": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*$"
                  },
                  "speed": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "op",
                  "animation",
                  "instance_id",
                  "speed",
                  "weight"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "stop_animation"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*(/[a-z][a-z0-9_.-]*)?$"
                  }
                },
                "required": [
                  "op",
                  "instance_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "pause_animation"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*(/[a-z][a-z0-9_.-]*)?$"
                  }
                },
                "required": [
                  "op",
                  "instance_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "resume_animation"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*(/[a-z][a-z0-9_.-]*)?$"
                  }
                },
                "required": [
                  "op",
                  "instance_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "seek_animation"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*(/[a-z][a-z0-9_.-]*)?$"
                  },
                  "time_s": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "op",
                  "instance_id",
                  "time_s"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "set_animation_speed"
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_.-]*(/[a-z][a-z0-9_.-]*)?$"
                  },
                  "speed": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "op",
                  "instance_id",
                  "speed"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "const": "reset"
                  }
                },
                "required": [
                  "op"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "document_type",
        "character_id",
        "actions"
      ],
      "additionalProperties": false
    }
  }
}
