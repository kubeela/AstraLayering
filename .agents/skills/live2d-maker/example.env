# 默认方案：全量 Codex + Codex 内置生图。首次创建 .env 前先按 references/model-presets.md 让用户确认方案。
# 确认后复制为 live2d-maker/.env；已有 .env 不覆盖。优化方案按 presets/optimized.env 替换对应键，自定义在选定方案上修改。
# 同名 shell 环境变量优先；不执行 shell 或展开变量。
# 模型枚举：gpt-6.1-sol / gpt-6-astra -> codex；claude-sonnet-5.5 / claude-opus-5.5 / claude-haiku-5.5 -> claude；gemini-4-argon -> agv。
# 最后一个后缀是思考力度：low / medium / high / xhigh。留空使用对应职责默认值。
# LLM 按职责配置，人物和衣服共用；生图按实际拥有工具的 agent 分别配置。
# Nano 透明后处理使用 --krita 的内嵌 Python，首次自动装包到运行根目录 .runtime；无额外路径变量。
# Python 优先复用宿主已有环境；缺少时由启动 agent 验证 Krita 内置脚本环境。

# Codex 不填或 false 时继承当前用户的订阅登录、provider 和 ~/.codex 配置。
layering_custom_provider=false
layering_provider_base_url=
layering_provider_api_key=

# 可选 CLI 绝对路径或相对 skill 的路径。Claude / agv 留空仅查找全局 PATH；不会自动安装。
layering_codex_path=
layering_codex_home=
layering_claude_path=
# 可指向 patch:agv 返回的受控入口；启动前校验内容，兼容新构建自动适配。
# CLI 自动更新开关使用 true（不能使用 1）；不兼容或开关未生效会明确报错。
layering_agv_path=
# 自定义 GenAI 网关拒绝 CLI 发出的 MINIMAL 时，可显式兼容为 LOW；默认留空，不修改任何力度。
# 仅替换 MINIMAL；支持 MINIMAL 的供应商保持留空。不会修改已经是 LOW / MEDIUM / HIGH 的请求。
layering_agv_minimal_thinking_level=
# 复用各 CLI 的已有登录。需要自定义主模型网关时，也可在此填写 CLI 原生环境变量，例如
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL，AGY_LLM_GATEWAY_API_KEY / AGY_LLM_GATEWAY_URL / AGY_LLM_GATEWAY_WIRE_PROTOCOL。
# 按需取消以下注释；不设置则复用已有登录／provider：
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# AGY_LLM_GATEWAY_API_KEY=
# AGY_LLM_GATEWAY_URL=
# AGY_LLM_GATEWAY_MODELS=gemini-4-argon
# AGY_LLM_GATEWAY_WIRE_PROTOCOL=genai

# 仅 Codex：按当前上下文图片数 compact，留空关闭；如上游最多 50 张，可填 49。
# 按图片数压缩和 Codex 自定义生图共用 pnpm build:codex 生成的补丁版，填写 layering_codex_path。
# 安装补丁本身不启用保护；pnpm env:check 检查生效值。换模型方案时保留已配置的阈值。
layering_image_compact_threshold=

# preparation 的全部 agent：姿态／画风判断、标准化、简化、素体和纯衣服准备。
layering_agent_preparation_model=gpt-6.1-sol-low

# 两套 part 共用。返修沿用绘制模型，首次分组与细分组共用，深度分析单独配置。
layering_agent_part_draw_model=gpt-6.1-sol-xhigh
layering_agent_part_review_model=gpt-6.1-sol-xhigh
layering_agent_part_reduce_model=gpt-6.1-sol-xhigh
layering_agent_part_completion_model=gpt-6.1-sol-xhigh
layering_agent_part_groups_model=gpt-6.1-sol-xhigh
layering_agent_part_depth_model=gpt-6.1-sol-xhigh
# SVG 合并由程序完成，不配置 LLM。

# 两套 raster 共用。step02 返修沿用 step02；step03 仅人物有。
layering_agent_raster_step01_model=gpt-6-astra-xhigh
layering_agent_raster_step02_model=gpt-6-astra-xhigh
layering_agent_raster_step02_review_model=gpt-6-astra-xhigh
layering_agent_raster_step03_model=gpt-6.1-sol-xhigh

# 后续人物与衣服组装仍独立配置。
layering_agent_assembly_model=gpt-6.1-sol-xhigh
# 投影蒙版与法线／深度共用阴影制作职责。
layering_agent_shadow_model=gpt-6.1-sol-xhigh
# 摆动物理三步，无生图职责。
layering_agent_physics_analysis_model=gpt-6.1-sol-xhigh
layering_agent_physics_authoring_model=gpt-6-astra-xhigh
layering_agent_physics_review_model=gpt-6-astra-xhigh

# 生图模型枚举：codex-native / gpt-image-2.5-sunburst / gpt-image-2.5-flare / gemini-nano-banana-2.1。
# codex-native 直接继承宿主 imagegen，不启用生图补丁；仅能与 Codex 模型配对。
# Codex 选择 GPT / Nano 并填写对应 API 时统一走补丁版原生 imagegen，需要 layering_codex_path。
# Claude / AGV 选择 GPT / Nano 时注册共享 image_generation 工具，不需要 Codex 补丁。
# 每个拥有生图工具的 agent 可以单独选择，不合并人物与衣服的生图配置；留空继承默认。
layering_default_image_model=codex-native
layering_part_standardize_image_model=
layering_part_simplify_image_model=
layering_part_base_subject_image_model=
layering_clothing_preparation_image_model=
layering_part_outline_image_model=
layering_part_outline_repair_image_model=
layering_clothing_outline_image_model=
layering_clothing_outline_repair_image_model=
layering_raster_step01_image_model=
layering_raster_step02_image_model=
layering_raster_step02_review_image_model=
layering_raster_step02_repair_image_model=
layering_raster_step03_image_model=
layering_clothing_raster_step01_image_model=
layering_clothing_raster_step02_image_model=
layering_clothing_raster_step02_review_image_model=
layering_clothing_raster_step02_repair_image_model=
layering_assembly_image_model=
layering_shadow_maps_image_model=

# 自定义 OpenAI 生图：API base URL 通常包含 /v1，工具在其后追加 /images/edits 或 /images/generations。
layering_openai_image_base_url=
layering_openai_image_api_key=
layering_openai_image_protocol=openai

# 自定义 Google 生图：gemini 原生协议的 base URL 通常包含 /v1beta；openai 协议通常包含 /v1。
# gemini 追加 /models/<模型>:generateContent；openai 使用 Images API。
layering_google_image_base_url=
layering_google_image_api_key=
layering_google_image_protocol=gemini

# 旧 layering_<小步骤>_model 在同一职责的值一致时仍可读取；不一致时须填写对应统一键。
# layering_agent_<职责>_model 优先；旧 medium/high 默认及 image_base_url / api_key / model 仍可读取。
