# 复制为 live2d-maker/.env。同名 shell 环境变量优先；不执行 shell 或展开变量。
# 模型枚举：gpt-6.1-sol / gpt-6-astra -> codex；claude-sonnet-5.5 / claude-opus-5.5 / claude-haiku-5.5 -> claude；gemini-4-argon -> agv。
# 最后一个后缀是思考力度：low / medium / high / xhigh。留空使用对应步骤默认值。
# 各小步骤独立配置；同一步骤的所有动态 group/part 共用。
# FFmpeg 直接检查已有命令，必要时复用 --krita 安装内的版本，不配置独立路径变量。
# Python 优先复用宿主已有环境；缺少时由启动 agent 验证 Krita 内置脚本环境。

# Codex 不填或 false 时继承当前用户的订阅登录、provider 和 ~/.codex 配置。
layering_custom_provider=false
layering_provider_base_url=
layering_provider_api_key=

# 可选 CLI 绝对路径或相对 skill 的路径。Claude / agv 留空仅查找全局 PATH；不会自动安装。
layering_codex_path=
layering_codex_home=
layering_claude_path=
layering_agv_path=
# 复用各 CLI 的已有登录。需要自定义主模型网关时，也可在此填写 CLI 原生环境变量，例如
# ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL，AGY_LLM_GATEWAY_API_KEY / AGY_LLM_GATEWAY_URL / AGY_LLM_GATEWAY_WIRE_PROTOCOL。
# 按需取消以下注释；不设置则复用已有登录／provider：
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# AGY_LLM_GATEWAY_API_KEY=
# AGY_LLM_GATEWAY_URL=
# AGY_LLM_GATEWAY_MODELS=gemini-4-argon
# AGY_LLM_GATEWAY_WIRE_PROTOCOL=genai

# 仅 Codex：按当前上下文图片数 compact，留空关闭；如上游最多 50 张，可填 49。
# 开启需要 pnpm build:codex 生成的补丁版，并填写 layering_codex_path。
layering_image_compact_threshold=

# 人物 part（包括 preparation）
layering_part_pose_judgment_model=gpt-6.1-sol-xhigh
layering_part_standardize_model=gpt-6.1-sol-xhigh
layering_part_reference_judgment_model=gpt-6.1-sol-xhigh
layering_part_simplify_model=gpt-6.1-sol-xhigh
layering_part_base_subject_model=gpt-6.1-sol-xhigh
layering_part_initial_groups_model=gpt-6.1-sol-xhigh
layering_part_outline_model=gpt-6.1-sol-xhigh
layering_part_outline_review_model=gpt-6.1-sol-xhigh
layering_part_outline_repair_model=gpt-6.1-sol-xhigh
layering_part_reduce_model=gpt-6.1-sol-xhigh
layering_part_completion_model=gpt-6.1-sol-xhigh
layering_part_children_model=gpt-6.1-sol-xhigh
layering_part_occlusion_model=gpt-6.1-sol-xhigh

# 衣服 part
layering_clothing_preparation_model=gpt-6.1-sol-xhigh
layering_clothing_initial_groups_model=gpt-6.1-sol-xhigh
layering_clothing_outline_model=gpt-6.1-sol-xhigh
layering_clothing_outline_review_model=gpt-6.1-sol-xhigh
layering_clothing_outline_repair_model=gpt-6.1-sol-xhigh
layering_clothing_reduce_model=gpt-6.1-sol-xhigh
layering_clothing_completion_model=gpt-6.1-sol-xhigh
layering_clothing_children_model=gpt-6.1-sol-xhigh
layering_clothing_occlusion_model=gpt-6.1-sol-xhigh

# 人物 raster
layering_raster_step01_model=gpt-6-astra-xhigh
layering_raster_step02_model=gpt-6-astra-xhigh
layering_raster_step02_review_model=gpt-6-astra-xhigh
layering_raster_step02_repair_model=gpt-6-astra-xhigh
layering_raster_step03_model=gpt-6.1-sol-xhigh

# 衣服 raster
layering_clothing_raster_step01_model=gpt-6-astra-xhigh
layering_clothing_raster_step02_model=gpt-6-astra-xhigh
layering_clothing_raster_step02_review_model=gpt-6-astra-xhigh
layering_clothing_raster_step02_repair_model=gpt-6-astra-xhigh

# 人物与衣服组装
layering_assembly_model=gpt-6.1-sol-xhigh

# 生图模型枚举：codex-native / gpt-image-2.5-sunburst / gpt-image-2.5-flare / gemini-nano-banana-2.1。
# codex-native 继承外部 Codex 内置 imagegen，仅能与 Codex 模型配对；不兼容时启动报错。
# 每个生图步骤可以单独选择；留空继承默认生图模型。
layering_default_image_model=codex-native
layering_part_standardize_image_model=
layering_part_simplify_image_model=
layering_part_base_subject_image_model=
layering_clothing_preparation_image_model=
layering_raster_step01_image_model=
layering_clothing_raster_step01_image_model=

# 自定义 OpenAI 生图：API base URL 通常包含 /v1，工具在其后追加 /images/edits 或 /images/generations。
layering_openai_image_base_url=
layering_openai_image_api_key=
layering_openai_image_protocol=openai

# 自定义 Google 生图：gemini 原生协议的 base URL 通常包含 /v1beta；openai 协议通常包含 /v1。
# gemini 追加 /models/<模型>:generateContent；openai 使用 Images API。
layering_google_image_base_url=
layering_google_image_api_key=
layering_google_image_protocol=gemini

# 旧 .env 的 layering_medium_model / layering_high_model 和 layering_image_base_url / api_key / model 仍可读取。
# 小步骤配置优先；新配置无需再使用这两个档位。
