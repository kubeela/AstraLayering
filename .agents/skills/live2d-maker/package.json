{
  "name": "astra-layering-workflows",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "part-layering": "node part-layering/run.ts",
    "raster-layering": "node raster-layering/run.ts",
    "clothing-part-layering": "node clothing-part-layering/run.ts",
    "clothing-raster-layering": "node clothing-raster-layering/run.ts",
    "character-assembly": "node character-assembly/run.ts",
    "check": "tsc",
    "test": "node --test shared/tests/*.test.ts part-layering/tests/*.test.ts raster-layering/tests/*.test.ts clothing-part-layering/tests/*.test.ts clothing-raster-layering/tests/*.test.ts character-assembly/tests/*.test.ts",
    "build:codex": "node tools/codex/build.ts"
  },
  "dependencies": { "@openai/codex-sdk": "0.161.0", "sharp": "0.35.5" },
  "devDependencies": { "@types/node": "24.19.1", "typescript": "7.0.2" }
}
