{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "region"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "将要在 submit_children 中提交的直属子节点 name。"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "description": "父组完成稿原画布坐标中的整数选框。框线须落在空白处，框内形状整体复制，框外形状整体排除。",
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
