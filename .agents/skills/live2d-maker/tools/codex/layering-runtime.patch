+    /// A separate Images API provider, without replacing the chat provider or login.
+    pub fn layering_image_provider() -> Option<Self> {
+        let base_url = std::env::var("LAYERING_IMAGE_BASE_URL").ok()?;
+        if base_url.trim().is_empty() {
+            return None;
+        }
+        Some(Self {
+            name: "Layering Images".to_string(),
+            base_url: Some(base_url),
+            env_key: Some("LAYERING_IMAGE_API_KEY".to_string()),
+            ..Self::default()
+        })
+    }
+
     pub fn is_openai(&self) -> bool {
         self.name == OPENAI_PROVIDER_NAME
     }
