diff --git a/codex-rs/core/src/astra_image_guard.rs b/codex-rs/core/src/astra_image_guard.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/core/src/astra_image_guard.rs
@@ -0,0 +1,189 @@
+//! Every image is either summarized with vision or retained unchanged in the
+//! replacement history. No unsupported-media projection is used for compaction.
+
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::ResponseItem;
+use std::collections::HashMap;
+
+pub(crate) fn threshold() -> Option<usize> {
+    std::env::var("LAYERING_IMAGE_COMPACT_THRESHOLD")
+        .ok()?
+        .parse::<usize>()
+        .ok()
+        .filter(|value| *value > 0)
+}
+
+fn item_image_count(item: &ResponseItem) -> usize {
+    match item {
+        ResponseItem::Message { content, .. } => content
+            .iter()
+            .filter(|part| matches!(part, ContentItem::InputImage { .. }))
+            .count(),
+        ResponseItem::FunctionCallOutput { output, .. }
+        | ResponseItem::CustomToolCallOutput { output, .. } => output
+            .content_items()
+            .unwrap_or_default()
+            .iter()
+            .filter(|part| matches!(part, FunctionCallOutputContentItem::InputImage { .. }))
+            .count(),
+        ResponseItem::ImageGenerationCall { result, .. } => usize::from(!result.is_empty()),
+        _ => 0,
+    }
+}
+
+pub(crate) fn image_count(items: &[ResponseItem]) -> usize {
+    items.iter().map(item_image_count).sum()
+}
+
+pub(crate) fn needs_compaction(items: &[ResponseItem]) -> bool {
+    threshold().is_some_and(|limit| image_count(items) >= limit)
+}
+
+fn deferred_image(index: usize) -> String {
+    format!(
+        "[Historical image {index} is retained unchanged after this summary for continued visual inspection; it is not included in this compaction request.]"
+    )
+}
+
+fn summarized_image(index: usize) -> String {
+    format!(
+        "[Historical image {index} was included in the preceding visual compaction. Its original remains in the saved thread history.]"
+    )
+}
+
+/// Split image payloads, preserving text, order, image detail, source envelopes,
+/// and original tool call/result pairs. A single oversized Code Mode result is
+/// supported; none of its completed operations needs to be executed again.
+pub(crate) fn partition_compaction(
+    items: Vec<ResponseItemEnvelope>,
+    limit: usize,
+) -> CodexResult<(Vec<ResponseItemEnvelope>, Vec<ResponseItemEnvelope>)> {
+    if limit == 0 {
+        return Err(CodexErr::InvalidRequest(
+            "Image compaction budget must be positive".into(),
+        ));
+    }
+    if items
+        .iter()
+        .map(|e| item_image_count(&e.item))
+        .sum::<usize>()
+        <= limit
+    {
+        return Ok((items, Vec::new()));
+    }
+    let mut calls = HashMap::new();
+    let mut projected = Vec::with_capacity(items.len());
+    let mut retained = Vec::new();
+    let mut seen = 0;
+    for mut envelope in items {
+        match &envelope.item {
+            ResponseItem::FunctionCall { call_id, .. }
+            | ResponseItem::CustomToolCall { call_id, .. } => {
+                calls.insert(call_id.clone(), envelope.clone());
+            }
+            ResponseItem::LocalShellCall {
+                call_id: Some(call_id),
+                ..
+            } => {
+                calls.insert(call_id.clone(), envelope.clone());
+            }
+            _ => {}
+        }
+        let count = item_image_count(&envelope.item);
+        if count == 0 || seen + count <= limit {
+            seen += count;
+            projected.push(envelope);
+            continue;
+        }
+        let mut carry = envelope.clone();
+        match (&mut envelope.item, &mut carry.item) {
+            (
+                ResponseItem::Message { content, internal_chat_message_metadata_passthrough: metadata, .. },
+                ResponseItem::Message { content: kept, internal_chat_message_metadata_passthrough: kept_metadata, .. },
+            ) => {
+                for (index, (part, pending)) in content.iter_mut().zip(kept.iter_mut()).enumerate() {
+                    if matches!(part, ContentItem::InputImage { .. }) {
+                        seen += 1;
+                        let changed_metadata = if seen <= limit {
+                            *pending = ContentItem::InputText {
+                                text: summarized_image(seen),
+                            };
+                            &mut *kept_metadata
+                        } else {
+                            *part = ContentItem::InputText {
+                                text: deferred_image(seen),
+                            };
+                            &mut *metadata
+                        };
+                        if let Some(kind) = changed_metadata.as_mut()
+                            .and_then(|metadata| metadata.content_item_kinds.as_mut())
+                            .and_then(|kinds| kinds.get_mut(index)) {
+                            kind.0 = "user.text".into();
+                        }
+                    }
+                }
+            }
+            (
+                ResponseItem::FunctionCallOutput { output, .. },
+                ResponseItem::FunctionCallOutput { output: kept, .. },
+            )
+            | (
+                ResponseItem::CustomToolCallOutput { output, .. },
+                ResponseItem::CustomToolCallOutput { output: kept, .. },
+            ) => {
+                if let (
+                    FunctionCallOutputBody::ContentItems(content),
+                    FunctionCallOutputBody::ContentItems(kept),
+                ) = (&mut output.body, &mut kept.body)
+                {
+                    for (part, pending) in content.iter_mut().zip(kept.iter_mut()) {
+                        if matches!(part, FunctionCallOutputContentItem::InputImage { .. }) {
+                            seen += 1;
+                            if seen <= limit {
+                                *pending = FunctionCallOutputContentItem::InputText {
+                                    text: summarized_image(seen),
+                                };
+                            } else {
+                                *part = FunctionCallOutputContentItem::InputText {
+                                    text: deferred_image(seen),
+                                };
+                            }
+                        }
+                    }
+                }
+            }
+            (
+                ResponseItem::ImageGenerationCall { result, .. },
+                ResponseItem::ImageGenerationCall { .. },
+            ) => {
+                seen += 1;
+                result.clear();
+            }
+            _ => unreachable!("image-bearing response item changed type"),
+        }
+        let call_id = match &carry.item {
+            ResponseItem::FunctionCallOutput { call_id, .. } => call_id.as_ref(),
+            ResponseItem::CustomToolCallOutput { call_id, .. } => Some(call_id),
+            _ => None,
+        };
+        if let Some(call_id) = call_id {
+            let call = calls.remove(call_id).ok_or_else(|| CodexErr::InvalidRequest(
+                format!("Cannot preserve image result without its original tool call {call_id}; history was not replaced")
+            ))?;
+            retained.push(call);
+        }
+        retained.push(carry);
+        projected.push(envelope);
+    }
+    projected.push(ResponseItemEnvelope::new(ResponseItem::Message {
+        id: None, role: "developer".into(), phase: None,
+        content: vec![ContentItem::InputText { text: "This visual compaction request contains a bounded prefix of the historical images. Images marked retained will be attached unchanged after your summary, with their original completed tool calls and output context; those tools must not be rerun just to retrieve them. Summarize the images provided here and preserve prior observations, completed checks, uncertainty, and remaining work accurately. Deferred images are pending visual inputs, not evidence that vision or tools are unavailable. Do not invalidate earlier observations merely because an image is deferred.".into() }],
+        internal_chat_message_metadata_passthrough: None,
+    }));
+    Ok((projected, retained))
+}
