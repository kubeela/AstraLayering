+fn external_edit_body(body: &serde_json::Value) -> Result<(Vec<u8>, http::HeaderValue), String> {
+    use base64::Engine;
+    let fields = body
+        .as_object()
+        .ok_or("Image edit body must be an object")?;
+    let images = fields
+        .get("images")
+        .and_then(serde_json::Value::as_array)
+        .filter(|images| !images.is_empty())
+        .ok_or("Image edit requires reference images")?;
+    let boundary = format!("layering-{}", uuid::Uuid::new_v4());
+    let mut output = Vec::new();
+    for (name, value) in fields {
+        if name == "images" || value.is_null() {
+            continue;
+        }
+        let text = value
+            .as_str()
+            .map(str::to_owned)
+            .unwrap_or_else(|| value.to_string());
+        output.extend_from_slice(
+            format!(
+                "--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n{text}\r\n"
+            )
+            .as_bytes(),
+        );
+    }
+    for (index, image) in images.iter().enumerate() {
+        let url = image
+            .get("image_url")
+            .and_then(serde_json::Value::as_str)
+            .ok_or("Missing image_url")?;
+        let (header, encoded) = url
+            .split_once(",")
+            .ok_or("Reference must be an embedded image")?;
+        let (mime, extension) = match header {
+            "data:image/png;base64" => ("image/png", "png"),
+            "data:image/jpeg;base64" => ("image/jpeg", "jpg"),
+            "data:image/webp;base64" => ("image/webp", "webp"),
+            _ => return Err("Unsupported embedded image format".to_string()),
+        };
+        let bytes = base64::engine::general_purpose::STANDARD
+            .decode(encoded)
+            .map_err(|_| "Invalid image base64")?;
+        if bytes.is_empty() {
+            return Err("Empty reference image".to_string());
+        }
+        output.extend_from_slice(format!("--{boundary}\r\nContent-Disposition: form-data; name=\"image[]\"; filename=\"reference-{index}.{extension}\"\r\nContent-Type: {mime}\r\n\r\n").as_bytes());
+        output.extend_from_slice(&bytes);
+        output.extend_from_slice(b"\r\n");
+    }
+    output.extend_from_slice(format!("--{boundary}--\r\n").as_bytes());
+    let header = http::HeaderValue::from_str(&format!("multipart/form-data; boundary={boundary}"))
+        .map_err(|_| "Invalid multipart boundary")?;
+    Ok((output, header))
+}
