{
  "type": "object",
  "properties": {
    "settings": {
      "type": "object",
      "properties": {
        "lightX": {
          "type": "number",
          "minimum": -6,
          "maximum": 6
        },
        "lightY": {
          "type": "number",
          "minimum": -6,
          "maximum": 6
        },
        "lightZ": {
          "type": "number",
          "minimum": -4,
          "maximum": 8
        },
        "lightColor": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ambient": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.7
        },
        "lightingMix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shade": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "toony": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "shift": {
          "type": "number",
          "minimum": -0.9,
          "maximum": 0.9
        },
        "normalStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "normalY": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "enum": [
            -1,
            1
          ]
        },
        "depthScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5
        },
        "shadow": {
          "type": "boolean"
        },
        "shadowStrength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "shadowSoftness": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "bias": {
          "type": "number",
          "minimum": -0.003,
          "maximum": 0.003
        },
        "rim": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "lightX",
        "lightY",
        "lightZ",
        "lightColor",
        "ambient",
        "lightingMix",
        "shade",
        "toony",
        "shift",
        "normalStrength",
        "normalY",
        "depthScale",
        "shadow",
        "shadowStrength",
        "shadowSoftness",
        "bias",
        "rim",
        "background"
      ],
      "additionalProperties": false
    },
    "final": {
      "type": "boolean",
      "description": "选定参数后保存 light.json 和 preview.png；测试时为 false"
    }
  },
  "required": [
    "settings",
    "final"
  ],
  "additionalProperties": false
}
