{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups"
  ],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "groups"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[\\p{L}\\p{N}_-]+(?:/[\\p{L}\\p{N}_-]+)*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "group",
            "part"
          ]
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "allowOutsideParent": {
          "type": "boolean",
          "description": "本节点的完整结构需要超出直接父组完成轮廓时为 true；仅跳过父轮廓包含检查。省略为 false。"
        },
        "hiddenInReference": {
          "type": "boolean",
          "description": "本节点确实存在且需在当前画布内制作，目标结构因遮挡或闭合完全不可见时为 true，跳过描边和轮廓 review、直接补全。局部可见、局部遮挡或仅肤色/材质被覆盖时为 false；例如连体服下仍可辨认形体的 torso、breast。整体画外且无需画内制作的实体省略。字段省略为 false。"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "note",
        "check"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/depth"
          }
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "note"
          ],
          "properties": {
            "passed": {
              "type": "boolean",
              "const": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "regions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/regionCheck"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "level"
          ]
        },
        {
          "required": [
            "levels"
          ]
        }
      ]
    },
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "region"
      ],
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0
        },
        "region": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "note"
      ],
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
