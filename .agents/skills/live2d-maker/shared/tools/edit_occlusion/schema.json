{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layers"
  ],
  "properties": {
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "note",
        "check"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "number",
          "minimum": 0
        },
        "levels": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/depth"
          }
        },
        "check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "note"
          ],
          "properties": {
            "passed": {
              "type": "boolean",
              "const": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "regions": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/regionCheck"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "level"
          ]
        },
        {
          "required": [
            "levels"
          ]
        }
      ]
    },
    "depth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "region"
      ],
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0
        },
        "region": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "regionCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "note"
      ],
      "properties": {
        "level": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
