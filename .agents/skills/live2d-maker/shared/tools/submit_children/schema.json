{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "children",
    "note"
  ],
  "properties": {
    "children": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "group",
              "part"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "allowOutsideParent": {
            "type": "boolean",
            "description": "本节点的完整结构需要超出直接父组完成轮廓时为 true；仅跳过父轮廓包含检查。省略为 false。"
          },
          "hiddenInReference": {
            "type": "boolean",
            "description": "本节点整体在原图中不可见、需要补设计时为 true；跳过描边和轮廓 review，直接补全。省略为 false。"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}
