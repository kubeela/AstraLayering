{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "children",
    "note"
  ],
  "properties": {
    "children": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "kind",
          "note"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "group",
              "part"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "简述实体范围、可见或遮挡依据、邻接及控制关系。外观只记录参考中可确认的事实，未知外观设计留给后续补全与绘制。"
          },
          "allowOutsideParent": {
            "type": "boolean",
            "description": "本节点的完整结构需要超出直接父组完成轮廓时为 true；仅跳过父轮廓包含检查。省略为 false。"
          },
          "hiddenInReference": {
            "type": "boolean",
            "description": "本节点在当前画布内需要制作，但因遮挡或闭合而整体不可见、需要补设计时为 true；跳过描边和轮廓 review，直接补全。完全位于画外且无需画内制作的实体不属于本标签场景。省略为 false。"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}
